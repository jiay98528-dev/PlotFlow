{
  "schemaVersion": 1,
  "id": "plotflow-narrative-workbench",
  "name": {
    "zh-CN": "叙事工作台",
    "en-US": "Narrative Workbench",
    "default": "叙事工作台"
  },
  "version": "1.0.0",
  "plotflowVersion": ">=0.1.0",
  "author": "Fablevia Team",
  "license": "Bundled",
  "description": "维叙（Fablevia）官方默认主题。以纸张工作台、蓝图线缆、清晰节点层级和克制动效服务长时间叙事设计。",
  "capabilities": [
    "tokens",
    "visual",
    "layout",
    "monaco"
  ],
  "tokens": {
    "shared": {
      "--theme-workbench-paper-grain": "#F0F1F3",
      "--theme-graph-lab-paper": "#F0F1F3",
      "--theme-graph-lab-surface": "#F9FAFB",
      "--theme-panel-surface": "#F9FAFB",
      "--theme-grid-size": "24px",
      "--theme-card-radius": "8px",
      "--theme-graph-node-radius": "10px",
      "--theme-graph-canvas-grid-opacity": "0.62",
      "--theme-graph-cable-default": "#8A929C",
      "--theme-graph-cable-conditional": "#8A929C",
      "--theme-graph-port": "#465F86",
      "--theme-port-fill": "#465F86",
      "--theme-source-dock-height": "340px",
      "--color-bg-primary": "#F9FAFB",
      "--color-bg-secondary": "#F0F1F3",
      "--color-bg-elevated": "#F9FAFB",
      "--color-text-primary": "#24282E",
      "--color-text-secondary": "#626A73",
      "--color-text-muted": "#626A73",
      "--color-text-on-accent": "#FFFFFF",
      "--color-border-light": "#D6DAE0",
      "--color-border-default": "#D6DAE0",
      "--color-border-subtle": "#D6DAE0",
      "--color-control-border": "#D6DAE0",
      "--color-accent": "#465F86",
      "--color-accent-subtle": "#E5EBF3",
      "--color-accent-surface": "#E5EBF3",
      "--color-control-bg": "#F9FAFB",
      "--color-control-bg-hover": "#E5EBF3",
      "--color-control-bg-active": "#E5EBF3",
      "--color-control-group-bg": "#F0F1F3",
      "--color-accent-hover": "color-mix(in srgb, #465F86, #24282E 15%)",
      "--theme-workbench-paper": "#F0F1F3",
      "--theme-workbench-panel": "#F9FAFB",
      "--theme-workbench-rail": "#F9FAFB",
      "--theme-blueprint-canvas": "#F0F1F3",
      "--theme-blueprint-cable": "#8A929C",
      "--theme-node-surface": "#F9FAFB",
      "--theme-node-surface-strong": "#F9FAFB",
      "--theme-node-border": "#D6DAE0",
      "--theme-node-ink": "#24282E",
      "--theme-node-muted": "#626A73",
      "--theme-workbench-shadow": "var(--shadow-sm)"
    },
    "light": {
      "--theme-workbench-paper": "#F0F1F3",
      "--theme-workbench-paper-warm": "oklch(0.945 0.007 248)",
      "--theme-workbench-rail": "#F9FAFB",
      "--theme-workbench-panel": "#F9FAFB",
      "--theme-blueprint-canvas": "#F0F1F3",
      "--theme-blueprint-grid": "oklch(0.76 0.018 250)",
      "--theme-blueprint-cable": "#8A929C",
      "--theme-node-surface": "#F9FAFB",
      "--theme-node-surface-strong": "#F9FAFB",
      "--theme-node-border": "#D6DAE0",
      "--theme-node-ink": "#24282E",
      "--theme-node-muted": "#626A73",
      "--theme-effect-line": "oklch(0.56 0.09 60)",
      "--theme-success-leaf": "oklch(0.52 0.075 150)",
      "--theme-warning-leaf": "oklch(0.68 0.09 82)",
      "--theme-danger-leaf": "oklch(0.55 0.12 30)",
      "--theme-workbench-shadow": "var(--shadow-sm)"
    },
    "dark": {
      "--theme-workbench-paper": "#F0F1F3",
      "--theme-workbench-paper-warm": "oklch(0.252 0.022 241)",
      "--theme-workbench-rail": "#F9FAFB",
      "--theme-workbench-panel": "#F9FAFB",
      "--theme-blueprint-canvas": "#F0F1F3",
      "--theme-blueprint-grid": "oklch(0.48 0.07 226)",
      "--theme-blueprint-cable": "#8A929C",
      "--theme-node-surface": "#F9FAFB",
      "--theme-node-surface-strong": "#F9FAFB",
      "--theme-node-border": "#D6DAE0",
      "--theme-node-ink": "#24282E",
      "--theme-node-muted": "#626A73",
      "--theme-effect-line": "oklch(0.73 0.13 57)",
      "--theme-success-leaf": "oklch(0.68 0.105 151)",
      "--theme-warning-leaf": "oklch(0.78 0.115 83)",
      "--theme-danger-leaf": "oklch(0.68 0.14 31)",
      "--theme-workbench-shadow": "var(--shadow-sm)"
    }
  },
  "monacoTheme": {
    "light": {
      "base": "vs",
      "inherit": true,
      "rules": [
        {
          "token": "heading",
          "foreground": "205B89",
          "fontStyle": "bold"
        },
        {
          "token": "keyword",
          "foreground": "2E6F78"
        },
        {
          "token": "string",
          "foreground": "9A542D"
        }
      ],
      "colors": {
        "editor.background": "#faf6ec",
        "editor.foreground": "#202322",
        "editorLineNumber.foreground": "#9a927f",
        "editorCursor.foreground": "#275f8a",
        "editor.selectionBackground": "#d6e7f2"
      }
    },
    "dark": {
      "base": "vs-dark",
      "inherit": true,
      "rules": [
        {
          "token": "heading",
          "foreground": "8FC7E6",
          "fontStyle": "bold"
        },
        {
          "token": "keyword",
          "foreground": "89D3C7"
        },
        {
          "token": "string",
          "foreground": "E5A36D"
        }
      ],
      "colors": {
        "editor.background": "#202632",
        "editor.foreground": "#ece8de",
        "editorLineNumber.foreground": "#8f98a5",
        "editorCursor.foreground": "#8fc7e6",
        "editor.selectionBackground": "#31546a"
      }
    }
  },
  "layoutRecipe": {
    "density": "comfortable",
    "graphLab": {
      "paletteWidth": 208,
      "railWidth": 208,
      "inspectorWidth": 384,
      "sourceDock": "bottom",
      "sourceDockHeight": 340,
      "nodeCardStyle": "blueprint-card",
      "cableStyle": "blueprint-cable",
      "motionIntensity": "restrained"
    }
  },
  "uxRecipe": {
    "appShell": {
      "layout": "editor-shell",
      "padding": "0",
      "gap": "0"
    },
    "home": {
      "layout": "hero-grid",
      "inset": "64px 0 26px",
      "padding": "clamp(var(--space-4), 3vw, var(--space-8))",
      "gap": "var(--space-5)",
      "opacity": "1"
    },
    "themeCenter": {
      "layout": "sidebar-catalog",
      "width": "min(960px, calc(100vw - 48px))",
      "height": "min(720px, calc(100vh - 48px))",
      "padding": "var(--space-6)",
      "gap": "var(--space-4)",
      "opacity": "1",
      "zIndex": "var(--z-modal)"
    },
    "graphLab": {
      "layout": "three-pane-canvas",
      "padding": "0",
      "gap": "0"
    },
    "split": {
      "layout": "balanced-editor-graph",
      "gap": "var(--space-3)"
    },
    "toolbar": {
      "height": "56px",
      "padding": "0 var(--space-5)",
      "gap": "var(--space-2)"
    },
    "panel": {
      "radius": "8px",
      "shadow": "var(--shadow-sm)",
      "opacity": "0.98"
    },
    "dock": {
      "height": "340px",
      "position": "bottom"
    },
    "node": {
      "width": "248px",
      "minHeight": "146px",
      "padding": "var(--space-3)",
      "radius": "10px",
      "opacity": "1"
    },
    "edge": {
      "width": "36px",
      "opacity": "1"
    },
    "typography": {
      "layout": "editorial",
      "gap": "var(--space-2)"
    }
  },
  "assets": {
    "preview": "assets/preview.png",
    "workbenchTexture": "assets/workbench-texture.svg",
    "nodeSurface": "assets/node-surface.svg"
  },
  "screenshots": [
    "assets/preview.png"
  ]
}
