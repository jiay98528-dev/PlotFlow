{
  "schemaVersion": 1,
  "id": "plotflow-prism-foundry",
  "name": {
    "zh-CN": "棱镜铸造台",
    "en-US": "Prism Foundry",
    "default": "Prism Foundry"
  },
  "tagline": {
    "zh-CN": "冷白液态玻璃 × 紫罗兰控制 × 青色信号",
    "en-US": "Cold-white liquid glass, violet control, cyan signal"
  },
  "version": "1.0.0",
  "plotflowVersion": ">=0.1.0",
  "author": "Fablevia Team",
  "license": "Bundled",
  "defaultMode": "light",
  "description": "维叙（Fablevia）默认亮色官方主题。它用冷白棱镜、受控液态玻璃与高不透明阅读面组织下一代游戏叙事工作台；玻璃只用于静态结构层，文本、表单、节点正文和源码始终保持清晰稳定。",
  "capabilities": [
    "tokens",
    "visual",
    "layout",
    "monaco"
  ],
  "tokens": {
    "shared": {
      "--theme-prism-foundry-shell": "oklch(0.978 0.012 274)",
      "--theme-prism-foundry-panel": "oklch(0.962 0.018 274 / 0.82)",
      "--theme-prism-foundry-glass": "oklch(0.99 0.018 274 / 0.64)",
      "--theme-prism-foundry-glass-strong": "oklch(0.975 0.02 274 / 0.86)",
      "--theme-prism-foundry-canvas": "oklch(0.946 0.028 264)",
      "--theme-prism-foundry-grid": "oklch(0.73 0.055 258 / 0.38)",
      "--theme-prism-foundry-violet": "oklch(0.55 0.2 301)",
      "--theme-prism-foundry-violet-strong": "oklch(0.47 0.21 300)",
      "--theme-prism-foundry-cyan": "oklch(0.64 0.13 210)",
      "--theme-prism-foundry-cyan-bright": "oklch(0.73 0.115 205)",
      "--theme-prism-foundry-shadow": "0 18px 48px oklch(0.34 0.07 282 / 0.16)",
      "--theme-prism-foundry-shadow-strong": "0 28px 72px oklch(0.3 0.09 285 / 0.22)",
      "--theme-prism-foundry-ease": "cubic-bezier(0.16, 1, 0.3, 1)",
      "--theme-prism-paper": "var(--theme-workbench-paper)",
      "--theme-prism-panel": "var(--theme-workbench-panel)",
      "--theme-prism-rail": "var(--theme-workbench-rail)",
      "--theme-prism-ink": "var(--theme-node-ink)",
      "--theme-prism-muted": "var(--theme-node-muted)",
      "--theme-prism-violet": "var(--theme-prism-foundry-violet)",
      "--theme-prism-signal": "var(--theme-prism-foundry-cyan)",
      "--theme-workbench-paper-grain": "#F7F6FC",
      "--theme-graph-lab-paper": "#F7F6FC",
      "--theme-graph-lab-surface": "#FFFFFF",
      "--theme-panel-surface": "#FFFFFF",
      "--theme-grid-size": "24px",
      "--theme-card-radius": "8px",
      "--theme-graph-node-radius": "10px",
      "--theme-graph-canvas-grid-opacity": "0.72",
      "--theme-graph-cable-default": "#9690A4",
      "--theme-graph-cable-conditional": "#9690A4",
      "--theme-graph-port": "#6C48D9",
      "--theme-port-fill": "#6C48D9",
      "--theme-source-dock-height": "324px",
      "--theme-workbench-shadow": "var(--shadow-sm)",
      "--color-bg-primary": "#FFFFFF",
      "--color-bg-secondary": "#F7F6FC",
      "--color-bg-elevated": "#FFFFFF",
      "--color-text-primary": "#252238",
      "--color-text-secondary": "#716B83",
      "--color-text-muted": "#716B83",
      "--color-text-on-accent": "#FFFFFF",
      "--color-border-light": "#DFDCEB",
      "--color-border-default": "#DFDCEB",
      "--color-border-subtle": "#DFDCEB",
      "--color-control-border": "#DFDCEB",
      "--color-accent": "#6C48D9",
      "--color-accent-subtle": "#EEE8FC",
      "--color-accent-surface": "#EEE8FC",
      "--color-control-bg": "#FFFFFF",
      "--color-control-bg-hover": "#EEE8FC",
      "--color-control-bg-active": "#EEE8FC",
      "--color-control-group-bg": "#F7F6FC",
      "--color-accent-hover": "color-mix(in srgb, #6C48D9, #252238 15%)",
      "--theme-workbench-paper": "#F7F6FC",
      "--theme-workbench-panel": "#FFFFFF",
      "--theme-workbench-rail": "#FFFFFF",
      "--theme-blueprint-canvas": "#F7F6FC",
      "--theme-blueprint-cable": "#9690A4",
      "--theme-node-surface": "#FFFFFF",
      "--theme-node-surface-strong": "#FFFFFF",
      "--theme-node-border": "#DFDCEB",
      "--theme-node-ink": "#252238",
      "--theme-node-muted": "#716B83"
    },
    "light": {
      "--theme-workbench-paper": "#F7F6FC",
      "--theme-workbench-paper-warm": "oklch(0.96 0.018 282)",
      "--theme-workbench-rail": "#FFFFFF",
      "--theme-workbench-panel": "#FFFFFF",
      "--theme-blueprint-canvas": "#F7F6FC",
      "--theme-blueprint-grid": "oklch(0.68 0.07 258)",
      "--theme-blueprint-cable": "#9690A4",
      "--theme-node-surface": "#FFFFFF",
      "--theme-node-surface-strong": "#FFFFFF",
      "--theme-node-border": "#DFDCEB",
      "--theme-node-ink": "#252238",
      "--theme-node-muted": "#716B83",
      "--theme-effect-line": "oklch(0.55 0.2 301)",
      "--theme-success-leaf": "oklch(0.57 0.12 160)",
      "--theme-warning-leaf": "oklch(0.72 0.13 83)",
      "--theme-danger-leaf": "oklch(0.57 0.17 28)"
    }
  },
  "monacoTheme": {
    "light": {
      "base": "vs",
      "inherit": true,
      "rules": [
        {
          "token": "heading",
          "foreground": "5636A4",
          "fontStyle": "bold"
        },
        {
          "token": "keyword",
          "foreground": "276A88"
        },
        {
          "token": "string",
          "foreground": "9A4F34"
        }
      ],
      "colors": {
        "editor.background": "#F8F8FF",
        "editor.foreground": "#25253F",
        "editorLineNumber.foreground": "#85839E",
        "editorCursor.foreground": "#6540B7",
        "editor.selectionBackground": "#E1DCF8",
        "editor.inactiveSelectionBackground": "#ECEAF6"
      }
    }
  },
  "layoutRecipe": {
    "density": "comfortable",
    "graphLab": {
      "paletteWidth": 208,
      "railWidth": 208,
      "inspectorWidth": 384,
      "sourceDock": "bottom",
      "sourceDockHeight": 324,
      "nodeCardStyle": "prism-liquid-card",
      "cableStyle": "cyan-signal-route",
      "motionIntensity": "restrained"
    }
  },
  "uxRecipe": {
    "appShell": {
      "layout": "prism-glass-shell",
      "padding": "0",
      "gap": "0"
    },
    "home": {
      "layout": "prism-studio-landing",
      "inset": "56px 0 28px",
      "padding": "clamp(var(--space-4), 3vw, var(--space-8))",
      "gap": "var(--space-5)",
      "opacity": "1"
    },
    "themeCenter": {
      "layout": "prism-glass-catalog",
      "width": "min(960px, calc(100vw - 48px))",
      "height": "min(720px, calc(100vh - 48px))",
      "padding": "var(--space-6)",
      "gap": "var(--space-4)",
      "opacity": "1",
      "zIndex": "var(--z-modal)"
    },
    "graphLab": {
      "layout": "prism-canvas-rack",
      "padding": "0",
      "gap": "0"
    },
    "split": {
      "layout": "prism-balanced-editor-graph",
      "gap": "var(--space-3)"
    },
    "toolbar": {
      "height": "56px",
      "padding": "0 var(--space-5)",
      "gap": "var(--space-2)"
    },
    "panel": {
      "radius": "8px",
      "shadow": "var(--shadow-sm)",
      "opacity": "0.98"
    },
    "dock": {
      "height": "324px",
      "position": "bottom"
    },
    "node": {
      "width": "248px",
      "minHeight": "146px",
      "padding": "var(--space-3)",
      "radius": "10px",
      "opacity": "1"
    },
    "edge": {
      "width": "42px",
      "opacity": "1"
    },
    "typography": {
      "layout": "precise-system",
      "gap": "var(--space-2)"
    }
  },
  "entryRecipe": {
    "graphLabDefaultEntry": "canvasFirst",
    "sourceDockDefault": "collapsed",
    "primaryActionLabel": {
      "zh-CN": "进入铸造台",
      "en-US": "Enter Foundry"
    }
  },
  "interactionRecipe": {
    "density": "balanced",
    "realtimeWirePreview": true,
    "highlightConnectTargets": true,
    "prominentPorts": true
  },
  "motionRecipe": {
    "intensity": "expressive",
    "nodeHoverLift": true,
    "cableGlow": true,
    "backgroundDrift": false
  },
  "storeMeta": {
    "availability": "bundled",
    "priceLabel": "随维叙（Fablevia）内置",
    "storeUrl": "https://plotflow.app/themes/plotflow-prism-foundry"
  },
  "assets": {
    "preview": "assets/preview.png"
  },
  "screenshots": [
    "assets/preview.png"
  ]
}
