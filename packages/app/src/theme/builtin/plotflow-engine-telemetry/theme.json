{
  "schemaVersion": 1,
  "id": "plotflow-engine-telemetry",
  "name": {
    "zh-CN": "引擎遥测台",
    "en-US": "Engine Telemetry",
    "default": "Engine Telemetry"
  },
  "tagline": {
    "zh-CN": "Source Spine + Topology Canvas + Inspector Rack",
    "en-US": "Source Spine + Topology Canvas + Inspector Rack"
  },
  "version": "1.0.0",
  "plotflowVersion": ">=0.1.0",
  "author": "Fablevia Team",
  "license": "Bundled",
  "defaultMode": "dark",
  "description": "维叙（Fablevia）官方内置主题。以石墨暗面、青绿信号线、琥珀状态光和红色错误提示构成游戏引擎遥测台，让画布成为主工作区，同时保持 .mdstory 源码持续可见。",
  "capabilities": [
    "tokens",
    "visual",
    "layout",
    "monaco"
  ],
  "tokens": {
    "shared": {
      "--theme-workbench-paper-grain": "#171C21",
      "--theme-graph-lab-paper": "#171C21",
      "--theme-graph-lab-surface": "#22282D",
      "--theme-panel-surface": "#22282D",
      "--theme-grid-size": "24px",
      "--theme-card-radius": "8px",
      "--theme-graph-node-radius": "10px",
      "--theme-graph-canvas-grid-opacity": "0.72",
      "--theme-graph-cable-default": "#77878E",
      "--theme-graph-cable-conditional": "#77878E",
      "--theme-graph-port": "#66D2C0",
      "--theme-port-fill": "#66D2C0",
      "--theme-source-dock-height": "300px",
      "--theme-workbench-shadow": "var(--shadow-sm)",
      "--color-bg-primary": "#22282D",
      "--color-bg-secondary": "#171C21",
      "--color-bg-elevated": "#22282D",
      "--color-text-primary": "#EEF3F5",
      "--color-text-secondary": "#AAB5BC",
      "--color-text-muted": "#AAB5BC",
      "--color-text-on-accent": "#152A27",
      "--color-border-light": "#455159",
      "--color-border-default": "#455159",
      "--color-border-subtle": "#455159",
      "--color-control-border": "#455159",
      "--color-accent": "#66D2C0",
      "--color-accent-subtle": "#273E3C",
      "--color-accent-surface": "#273E3C",
      "--color-control-bg": "#22282D",
      "--color-control-bg-hover": "#273E3C",
      "--color-control-bg-active": "#273E3C",
      "--color-control-group-bg": "#171C21",
      "--color-accent-hover": "color-mix(in srgb, #66D2C0, #EEF3F5 15%)",
      "--theme-workbench-paper": "#171C21",
      "--theme-workbench-panel": "#22282D",
      "--theme-workbench-rail": "#22282D",
      "--theme-blueprint-canvas": "#171C21",
      "--theme-blueprint-cable": "#77878E",
      "--theme-node-surface": "#22282D",
      "--theme-node-surface-strong": "#22282D",
      "--theme-node-border": "#455159",
      "--theme-node-ink": "#EEF3F5",
      "--theme-node-muted": "#AAB5BC"
    },
    "light": {
      "--theme-workbench-paper": "#171C21",
      "--theme-workbench-paper-warm": "oklch(0.87 0.014 228)",
      "--theme-workbench-rail": "#22282D",
      "--theme-workbench-panel": "#22282D",
      "--theme-blueprint-canvas": "#171C21",
      "--theme-blueprint-grid": "oklch(0.62 0.055 204)",
      "--theme-blueprint-cable": "#77878E",
      "--theme-node-surface": "#22282D",
      "--theme-node-surface-strong": "#22282D",
      "--theme-node-border": "#455159",
      "--theme-node-ink": "#EEF3F5",
      "--theme-node-muted": "#AAB5BC",
      "--theme-signal-line": "oklch(0.56 0.12 186)",
      "--theme-status-amber": "oklch(0.7 0.145 75)",
      "--theme-danger-signal": "oklch(0.57 0.16 31)",
      "--theme-success-leaf": "oklch(0.57 0.12 154)",
      "--theme-warning-leaf": "var(--theme-status-amber)",
      "--theme-danger-leaf": "var(--theme-danger-signal)",
      "--theme-console-shadow": "0 18px 42px oklch(0.26 0.03 238 / 0.22)"
    },
    "dark": {
      "--theme-workbench-paper": "#171C21",
      "--theme-workbench-paper-warm": "oklch(0.205 0.019 238)",
      "--theme-workbench-rail": "#22282D",
      "--theme-workbench-panel": "#22282D",
      "--theme-blueprint-canvas": "#171C21",
      "--theme-blueprint-grid": "oklch(0.34 0.035 210)",
      "--theme-blueprint-cable": "#77878E",
      "--theme-node-surface": "#22282D",
      "--theme-node-surface-strong": "#22282D",
      "--theme-node-border": "#455159",
      "--theme-node-ink": "#EEF3F5",
      "--theme-node-muted": "#AAB5BC",
      "--theme-signal-line": "oklch(0.72 0.095 188)",
      "--theme-status-amber": "oklch(0.74 0.105 77)",
      "--theme-danger-signal": "oklch(0.66 0.13 32)",
      "--theme-success-leaf": "oklch(0.66 0.09 154)",
      "--theme-warning-leaf": "var(--theme-status-amber)",
      "--theme-danger-leaf": "var(--theme-danger-signal)",
      "--theme-console-shadow": "0 16px 38px oklch(0.06 0.012 244 / 0.5)"
    }
  },
  "monacoTheme": {
    "light": {
      "base": "vs",
      "inherit": true,
      "rules": [
        {
          "token": "heading",
          "foreground": "295C66",
          "fontStyle": "bold"
        },
        {
          "token": "keyword",
          "foreground": "1C7C75"
        },
        {
          "token": "string",
          "foreground": "935B14"
        }
      ],
      "colors": {
        "editor.background": "#e8ebee",
        "editor.foreground": "#202528",
        "editorLineNumber.foreground": "#758189",
        "editorCursor.foreground": "#177e77",
        "editor.selectionBackground": "#bddeda"
      }
    },
    "dark": {
      "base": "vs-dark",
      "inherit": true,
      "rules": [
        {
          "token": "heading",
          "foreground": "7DE2D1",
          "fontStyle": "bold"
        },
        {
          "token": "keyword",
          "foreground": "B7E07F"
        },
        {
          "token": "string",
          "foreground": "F3B65C"
        }
      ],
      "colors": {
        "editor.background": "#111a20",
        "editor.foreground": "#e7eee9",
        "editorLineNumber.foreground": "#71808a",
        "editorCursor.foreground": "#7de2d1",
        "editor.selectionBackground": "#234e57"
      }
    }
  },
  "layoutRecipe": {
    "density": "compact",
    "graphLab": {
      "paletteWidth": 208,
      "railWidth": 208,
      "inspectorWidth": 384,
      "sourceDock": "bottom",
      "sourceDockHeight": 300,
      "nodeCardStyle": "engine-telemetry-module",
      "cableStyle": "signal-route",
      "motionIntensity": "restrained"
    }
  },
  "uxRecipe": {
    "appShell": {
      "layout": "engine-console",
      "padding": "0",
      "gap": "0"
    },
    "home": {
      "layout": "telemetry-console",
      "inset": "48px 0 24px",
      "padding": "clamp(var(--space-4), 2.4vw, var(--space-7))",
      "gap": "var(--space-5)",
      "opacity": "1"
    },
    "themeCenter": {
      "layout": "telemetry-catalog",
      "width": "min(960px, calc(100vw - 48px))",
      "height": "min(720px, calc(100vh - 48px))",
      "padding": "var(--space-5)",
      "gap": "var(--space-4)",
      "opacity": "1",
      "zIndex": "var(--z-modal)"
    },
    "graphLab": {
      "layout": "source-spine-topology-inspector",
      "padding": "0",
      "gap": "0"
    },
    "split": {
      "layout": "source-spine-topology",
      "gap": "var(--space-2)"
    },
    "toolbar": {
      "height": "56px",
      "padding": "0 var(--space-5)",
      "gap": "var(--space-2)"
    },
    "panel": {
      "radius": "8px",
      "shadow": "var(--shadow-sm)",
      "opacity": "0.98"
    },
    "dock": {
      "height": "300px",
      "position": "right"
    },
    "node": {
      "width": "248px",
      "minHeight": "146px",
      "padding": "var(--space-3)",
      "radius": "10px",
      "opacity": "1"
    },
    "edge": {
      "width": "40px",
      "opacity": "1"
    },
    "typography": {
      "layout": "instrument-panel",
      "gap": "var(--space-2)"
    }
  },
  "entryRecipe": {
    "graphLabDefaultEntry": "canvasFirst",
    "sourceDockDefault": "collapsed",
    "primaryActionLabel": {
      "zh-CN": "进入遥测台",
      "en-US": "Open Console"
    }
  },
  "interactionRecipe": {
    "density": "dense",
    "realtimeWirePreview": true,
    "highlightConnectTargets": true,
    "prominentPorts": true
  },
  "motionRecipe": {
    "intensity": "subtle",
    "nodeHoverLift": true,
    "cableGlow": true,
    "backgroundDrift": false
  },
  "storeMeta": {
    "availability": "bundled",
    "priceLabel": "已随维叙（Fablevia）内置",
    "storeUrl": "https://plotflow.app/themes/plotflow-engine-telemetry"
  },
  "assets": {
    "preview": "assets/preview.png"
  },
  "screenshots": [
    "assets/preview.png"
  ]
}
